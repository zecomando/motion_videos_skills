{
  "name": "talking-head-motion-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Starter local de edição talking-head; substituir os dados de demonstração.",
  "scripts": {
    "check": "tsc --noEmit",
    "studio": "remotion studio src/index.ts",
    "still": "remotion still src/index.ts TalkingHead out/check.png --props=timeline.example.json",
    "render": "remotion render src/index.ts TalkingHead out/final.mp4 --props=timeline.example.json --codec=h264 --pixel-format=yuv420p"
  },
  "dependencies": {
    "@remotion/captions": "4.0.529",
    "@remotion/cli": "4.0.529",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.3"
  },
  "engines": {"node": ">=20"}
}
